<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Distribution.Connect\Distribution.Connect.csproj" />
    <ProjectReference Include="..\Distribution.Domain\Distribution.Domain.csproj" />
    <ProjectReference Include="..\Distribution.Services\Distribution.Services.csproj" />
    <ProjectReference Include="..\Distribution.Reports\Distribution.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The version customers see, and the one the update check compares against.
         Raise it for every release you publish. -->
    <Version>1.0.0</Version>
    <AssemblyTitle>Distribution Management System</AssemblyTitle>
    <Product>Distribution Management System</Product>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Custom controls are built entirely in code, not via the WinForms visual designer,
         so designer code-serialization support (WFO1000) does not apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

</Project>
